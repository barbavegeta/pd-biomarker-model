    skos:hasTopConcept <https://w3id.org/pd-biomarker-model/vocab/SexEnum/FEMALE>,
        <https://w3id.org/pd-biomarker-model/vocab/SexEnum/MALE> ;
    skos:prefLabel "SexEnum"@en .

