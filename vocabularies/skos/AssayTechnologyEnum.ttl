<https://w3id.org/pd-biomarker-model/vocab/AssayTechnologyEnum/SEED_AMPLIFICATION_ASSAY> a skos:Concept ;
    skos:broadMatch <http://purl.obolibrary.org/obo/OBI_0000070> ;
