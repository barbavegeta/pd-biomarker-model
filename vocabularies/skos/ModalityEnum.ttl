@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/pd-biomarker-model/vocab/ModalityEnum/IMAGING> a skos:Concept ;
    skos:definition "Measured from an imaging scan."@en ;
    skos:exactMatch <http://purl.obolibrary.org/obo/OBI_0000185> ;
    skos:inScheme <https://w3id.org/pd-biomarker-model/vocab/ModalityEnum> ;
    skos:notation "IMAGING" ;
    skos:prefLabel "imaging assay"@en ;
    skos:topConceptOf <https://w3id.org/pd-biomarker-model/vocab/ModalityEnum> .

<https://w3id.org/pd-biomarker-model/vocab/ModalityEnum/SPECIMEN> a skos:Concept ;
    skos:definition "Measured in a fluid or tissue specimen."@en ;
    skos:inScheme <https://w3id.org/pd-biomarker-model/vocab/ModalityEnum> ;
    skos:notation "SPECIMEN" ;
    skos:prefLabel "SPECIMEN"@en ;
    skos:topConceptOf <https://w3id.org/pd-biomarker-model/vocab/ModalityEnum> .

<https://w3id.org/pd-biomarker-model/vocab/ModalityEnum> a skos:ConceptScheme ;
    dcterms:description "Source of a biomarker value."@en ;
    dcterms:license <https://spdx.org/licenses/MIT> ;
    dcterms:source <https://w3id.org/pd-biomarker-model/core> ;
    dcterms:title "ModalityEnum"@en ;
    owl:versionInfo "0.2.1" ;
    skos:hasTopConcept <https://w3id.org/pd-biomarker-model/vocab/ModalityEnum/IMAGING>,
        <https://w3id.org/pd-biomarker-model/vocab/ModalityEnum/SPECIMEN> ;
    skos:prefLabel "ModalityEnum"@en .

