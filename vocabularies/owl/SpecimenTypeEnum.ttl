@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

obo:IAO_0000115 a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

skos:broadMatch a owl:AnnotationProperty .

skos:closeMatch a owl:AnnotationProperty .

skos:exactMatch a owl:AnnotationProperty .

skos:narrowMatch a owl:AnnotationProperty .

skos:notation a owl:AnnotationProperty .

skos:relatedMatch a owl:AnnotationProperty .

<https://w3id.org/pd-biomarker-model/vocab/SpecimenTypeEnum.owl> a owl:Ontology ;
    dcterms:description "Anatomical material a specimen consists of."@en ;
    dcterms:license <https://spdx.org/licenses/MIT> ;
    dcterms:source <https://w3id.org/pd-biomarker-model/core> ;
    dcterms:title "SpecimenTypeEnum"@en ;
    owl:versionInfo "0.2.0" .

<https://w3id.org/pd-biomarker-model/vocab/SpecimenTypeEnum/CSF> a owl:Class ;
    rdfs:label "cerebrospinal fluid"@en ;
    obo:IAO_0000115 "Cerebrospinal fluid."@en ;
    rdfs:subClassOf <https://w3id.org/pd-biomarker-model/vocab/SpecimenTypeEnum> ;
    skos:exactMatch obo:UBERON_0001359 ;
    skos:notation "CSF" .

<https://w3id.org/pd-biomarker-model/vocab/SpecimenTypeEnum/PLASMA> a owl:Class ;
    rdfs:label "blood plasma"@en ;
    obo:IAO_0000115 "Blood plasma."@en ;
    rdfs:subClassOf <https://w3id.org/pd-biomarker-model/vocab/SpecimenTypeEnum> ;
    skos:exactMatch obo:UBERON_0001969 ;
    skos:notation "PLASMA" .

<https://w3id.org/pd-biomarker-model/vocab/SpecimenTypeEnum/SERUM> a owl:Class ;
    rdfs:label "blood serum"@en ;
    obo:IAO_0000115 "Blood serum."@en ;
    rdfs:subClassOf <https://w3id.org/pd-biomarker-model/vocab/SpecimenTypeEnum> ;
    skos:exactMatch obo:UBERON_0001977 ;
    skos:notation "SERUM" .

<https://w3id.org/pd-biomarker-model/vocab/SpecimenTypeEnum/SKIN> a owl:Class ;
    rdfs:label "skin of body"@en ;
    obo:IAO_0000115 "Skin biopsy."@en ;
    rdfs:subClassOf <https://w3id.org/pd-biomarker-model/vocab/SpecimenTypeEnum> ;
    skos:exactMatch obo:UBERON_0002097 ;
    skos:notation "SKIN" .

<https://w3id.org/pd-biomarker-model/vocab/SpecimenTypeEnum/WHOLE_BLOOD> a owl:Class ;
    rdfs:label "blood"@en ;
    obo:IAO_0000115 "Whole blood."@en ;
    rdfs:subClassOf <https://w3id.org/pd-biomarker-model/vocab/SpecimenTypeEnum> ;
    skos:exactMatch obo:UBERON_0000178 ;
    skos:notation "WHOLE_BLOOD" .

<https://w3id.org/pd-biomarker-model/vocab/SpecimenTypeEnum> a owl:Class ;
    rdfs:label "SpecimenTypeEnum"@en ;
    obo:IAO_0000115 "Anatomical material a specimen consists of."@en .

