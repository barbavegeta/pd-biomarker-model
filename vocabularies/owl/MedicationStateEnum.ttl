@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

obo:IAO_0000115 a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

skos:broadMatch a owl:AnnotationProperty .

skos:closeMatch a owl:AnnotationProperty .

skos:exactMatch a owl:AnnotationProperty .

skos:narrowMatch a owl:AnnotationProperty .

skos:notation a owl:AnnotationProperty .

skos:relatedMatch a owl:AnnotationProperty .

<https://w3id.org/pd-biomarker-model/vocab/MedicationStateEnum.owl> a owl:Ontology ;
    dcterms:description "Dopaminergic medication state during a motor examination."@en ;
    dcterms:license <https://spdx.org/licenses/MIT> ;
    dcterms:source <https://w3id.org/pd-biomarker-model> ;
    dcterms:title "MedicationStateEnum"@en ;
    owl:versionInfo "0.3.0" .

<https://w3id.org/pd-biomarker-model/vocab/MedicationStateEnum/OFF> a owl:Class ;
    rdfs:label "OFF"@en ;
    obo:IAO_0000115 "Examined after withholding dopaminergic medication."@en ;
    rdfs:subClassOf <https://w3id.org/pd-biomarker-model/vocab/MedicationStateEnum> ;
    skos:notation "OFF" .

<https://w3id.org/pd-biomarker-model/vocab/MedicationStateEnum/ON> a owl:Class ;
    rdfs:label "ON"@en ;
    obo:IAO_0000115 "Examined while responding to dopaminergic medication."@en ;
    rdfs:subClassOf <https://w3id.org/pd-biomarker-model/vocab/MedicationStateEnum> ;
    skos:notation "ON" .

<https://w3id.org/pd-biomarker-model/vocab/MedicationStateEnum/UNTREATED> a owl:Class ;
    rdfs:label "UNTREATED"@en ;
    obo:IAO_0000115 "Not yet taking dopaminergic medication."@en ;
    rdfs:subClassOf <https://w3id.org/pd-biomarker-model/vocab/MedicationStateEnum> ;
    skos:notation "UNTREATED" .

<https://w3id.org/pd-biomarker-model/vocab/MedicationStateEnum> a owl:Class ;
    rdfs:label "MedicationStateEnum"@en ;
    obo:IAO_0000115 "Dopaminergic medication state during a motor examination."@en .

