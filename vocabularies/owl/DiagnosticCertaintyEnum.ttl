<https://w3id.org/pd-biomarker-model/vocab/DiagnosticCertaintyEnum/CLINICALLY_ESTABLISHED> a owl:Class ;
    rdfs:label "CLINICALLY_ESTABLISHED"@en ;
    obo:IAO_0000115 "Clinically established (MDS PD and MSA criteria)."@en ;
    rdfs:subClassOf <https://w3id.org/pd-biomarker-model/vocab/DiagnosticCertaintyEnum> ;
    skos:notation "CLINICALLY_ESTABLISHED" .

<https://w3id.org/pd-biomarker-model/vocab/DiagnosticCertaintyEnum/POSSIBLE> a owl:Class ;
    rdfs:label "POSSIBLE"@en ;
    obo:IAO_0000115 "Possible (PSP and DLB criteria)."@en ;
