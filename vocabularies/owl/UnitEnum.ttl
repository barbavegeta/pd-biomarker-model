@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

obo:IAO_0000115 a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

skos:broadMatch a owl:AnnotationProperty .

skos:closeMatch a owl:AnnotationProperty .

skos:exactMatch a owl:AnnotationProperty .

skos:narrowMatch a owl:AnnotationProperty .

skos:notation a owl:AnnotationProperty .

skos:relatedMatch a owl:AnnotationProperty .

<https://w3id.org/pd-biomarker-model/vocab/UnitEnum.owl> a owl:Ontology ;
    dcterms:description "Units as case-sensitive UCUM codes. Curly-brace codes are UCUM annotations for arbitrary, platform-specific units."@en ;
    dcterms:license <https://spdx.org/licenses/MIT> ;
    dcterms:source <https://w3id.org/pd-biomarker-model/core> ;
    dcterms:title "UnitEnum"@en ;
    owl:versionInfo "0.2.1" .

<https://w3id.org/pd-biomarker-model/vocab/UnitEnum/%7BNPX%7D> a owl:Class ;
    rdfs:label "{NPX}"@en ;
    obo:IAO_0000115 "Olink normalised protein expression, an arbitrary log2 unit."@en ;
    rdfs:subClassOf <https://w3id.org/pd-biomarker-model/vocab/UnitEnum> ;
    skos:notation "{NPX}" .

<https://w3id.org/pd-biomarker-model/vocab/UnitEnum/%7BRFU%7D> a owl:Class ;
    rdfs:label "Relative Fluorescence Intensity Unit"@en ;
    obo:IAO_0000115 "SomaScan relative fluorescence units."@en ;
    rdfs:subClassOf <https://w3id.org/pd-biomarker-model/vocab/UnitEnum> ;
    skos:exactMatch obo:NCIT_C77535 ;
    skos:notation "{RFU}" .

<https://w3id.org/pd-biomarker-model/vocab/UnitEnum/1> a owl:Class ;
    rdfs:label "dimensionless unit"@en ;
    obo:IAO_0000115 "Dimensionless (UCUM unity), used for ratios."@en ;
    rdfs:subClassOf <https://w3id.org/pd-biomarker-model/vocab/UnitEnum> ;
    skos:exactMatch obo:UO_0000186 ;
    skos:notation "1" .

<https://w3id.org/pd-biomarker-model/vocab/UnitEnum/ng%2FmL> a owl:Class ;
    rdfs:label "nanogram per milliliter"@en ;
    obo:IAO_0000115 "Nanograms per millilitre."@en ;
    rdfs:subClassOf <https://w3id.org/pd-biomarker-model/vocab/UnitEnum> ;
    skos:exactMatch obo:UO_0000275 ;
    skos:notation "ng/mL" .

<https://w3id.org/pd-biomarker-model/vocab/UnitEnum/pg%2FmL> a owl:Class ;
    rdfs:label "picogram per milliliter"@en ;
    obo:IAO_0000115 "Picograms per millilitre."@en ;
    rdfs:subClassOf <https://w3id.org/pd-biomarker-model/vocab/UnitEnum> ;
    skos:exactMatch obo:UO_0010070 ;
    skos:notation "pg/mL" .

<https://w3id.org/pd-biomarker-model/vocab/UnitEnum> a owl:Class ;
    rdfs:label "UnitEnum"@en ;
    obo:IAO_0000115 "Units as case-sensitive UCUM codes. Curly-brace codes are UCUM annotations for arbitrary, platform-specific units."@en .

