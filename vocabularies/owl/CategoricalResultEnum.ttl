@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

obo:IAO_0000115 a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

skos:broadMatch a owl:AnnotationProperty .

skos:closeMatch a owl:AnnotationProperty .

skos:exactMatch a owl:AnnotationProperty .

skos:narrowMatch a owl:AnnotationProperty .

skos:notation a owl:AnnotationProperty .

skos:relatedMatch a owl:AnnotationProperty .

<https://w3id.org/pd-biomarker-model/vocab/CategoricalResultEnum.owl> a owl:Ontology ;
    dcterms:description "Result of a qualitative assay."@en ;
    dcterms:license <https://spdx.org/licenses/MIT> ;
    dcterms:source <https://w3id.org/pd-biomarker-model/core> ;
    dcterms:title "CategoricalResultEnum"@en ;
    owl:versionInfo "0.1.0" .

<https://w3id.org/pd-biomarker-model/vocab/CategoricalResultEnum/INDETERMINATE> a owl:Class ;
    rdfs:label "Indeterminate"@en ;
    obo:IAO_0000115 "The result could not be called positive or negative."@en ;
    rdfs:subClassOf <https://w3id.org/pd-biomarker-model/vocab/CategoricalResultEnum> ;
    skos:exactMatch obo:NCIT_C48658 ;
    skos:notation "INDETERMINATE" .

<https://w3id.org/pd-biomarker-model/vocab/CategoricalResultEnum/NEGATIVE> a owl:Class ;
    rdfs:label "Negative Finding"@en ;
    obo:IAO_0000115 "The target was not detected."@en ;
    rdfs:subClassOf <https://w3id.org/pd-biomarker-model/vocab/CategoricalResultEnum> ;
    skos:exactMatch obo:NCIT_C38757 ;
    skos:notation "NEGATIVE" .

<https://w3id.org/pd-biomarker-model/vocab/CategoricalResultEnum/POSITIVE> a owl:Class ;
    rdfs:label "Positive Finding"@en ;
    obo:IAO_0000115 "The target was detected."@en ;
    rdfs:subClassOf <https://w3id.org/pd-biomarker-model/vocab/CategoricalResultEnum> ;
    skos:exactMatch obo:NCIT_C38758 ;
    skos:notation "POSITIVE" .

<https://w3id.org/pd-biomarker-model/vocab/CategoricalResultEnum> a owl:Class ;
    rdfs:label "CategoricalResultEnum"@en ;
    obo:IAO_0000115 "Result of a qualitative assay."@en .

