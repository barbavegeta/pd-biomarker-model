@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

obo:IAO_0000115 a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

skos:broadMatch a owl:AnnotationProperty .

skos:closeMatch a owl:AnnotationProperty .

skos:exactMatch a owl:AnnotationProperty .

skos:narrowMatch a owl:AnnotationProperty .

skos:notation a owl:AnnotationProperty .

skos:relatedMatch a owl:AnnotationProperty .

<https://w3id.org/pd-biomarker-model/vocab/MeasurementTypeEnum.owl> a owl:Ontology ;
    dcterms:description "Kind of quantity a biomarker value represents."@en ;
    dcterms:license <https://spdx.org/licenses/MIT> ;
    dcterms:source <https://w3id.org/pd-biomarker-model/core> ;
    dcterms:title "MeasurementTypeEnum"@en ;
    owl:versionInfo "0.3.0" .

<https://w3id.org/pd-biomarker-model/vocab/MeasurementTypeEnum/CATEGORICAL> a owl:Class ;
    rdfs:label "CATEGORICAL"@en ;
    obo:IAO_0000115 "Qualitative result, e.g. a seed amplification assay call."@en ;
    rdfs:subClassOf <https://w3id.org/pd-biomarker-model/vocab/MeasurementTypeEnum> ;
    skos:notation "CATEGORICAL" .

<https://w3id.org/pd-biomarker-model/vocab/MeasurementTypeEnum/CONCENTRATION> a owl:Class ;
    rdfs:label "concentration of"@en ;
    obo:IAO_0000115 "Absolute amount per volume, e.g. pg/mL."@en ;
    rdfs:subClassOf <https://w3id.org/pd-biomarker-model/vocab/MeasurementTypeEnum> ;
    skos:exactMatch obo:PATO_0000033 ;
    skos:notation "CONCENTRATION" .

<https://w3id.org/pd-biomarker-model/vocab/MeasurementTypeEnum/RATIO> a owl:Class ;
    rdfs:label "ratio"@en ;
    obo:IAO_0000115 "Dimensionless ratio, e.g. a DaT-SPECT specific binding ratio."@en ;
    rdfs:subClassOf <https://w3id.org/pd-biomarker-model/vocab/MeasurementTypeEnum> ;
    skos:exactMatch obo:STATO_0000184 ;
    skos:notation "RATIO" .

<https://w3id.org/pd-biomarker-model/vocab/MeasurementTypeEnum/RELATIVE_ABUNDANCE> a owl:Class ;
    rdfs:label "RELATIVE_ABUNDANCE"@en ;
    obo:IAO_0000115 "Platform-relative signal that is not an absolute concentration, e.g. SomaScan RFU or Olink NPX."@en ;
    rdfs:subClassOf <https://w3id.org/pd-biomarker-model/vocab/MeasurementTypeEnum> ;
    skos:notation "RELATIVE_ABUNDANCE" .

<https://w3id.org/pd-biomarker-model/vocab/MeasurementTypeEnum> a owl:Class ;
    rdfs:label "MeasurementTypeEnum"@en ;
    obo:IAO_0000115 "Kind of quantity a biomarker value represents."@en .

