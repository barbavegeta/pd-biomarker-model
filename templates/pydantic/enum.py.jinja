{#- Override of LinkML's pydantic enum template.
    Static enums are rendered as before. A dynamic enum (reachable_from) has no
    permissible values, and the default template renders it as an empty str
    subclass that Pydantic cannot build from a plain string. Here it accepts
    any string; ontology membership is checked by DatasetDynamicEnumPlugin. -#}
class {{ name }}(str{% if values %}, Enum{% endif %}):
{% if description %}
    """
    {{ description }}
    """
{% endif %}
{% if values %}
    {% for pv in values.values() %}
    {{pv.label}} = "{{pv.value}}"
        {% if pv.description %}
    """
    {{ pv.description | indent(width=4) }}
    """
        {% endif %}
    {% endfor %}
{% else %}

    @classmethod
    def __get_pydantic_core_schema__(cls, source_type: Any, handler: Any) -> Any:
        from pydantic_core import core_schema

        return core_schema.no_info_after_validator_function(cls, core_schema.str_schema())
{% endif %}
